        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 300,\n  \"system\": \"You are the Anomaly/Fraud Signal Agent for a card payments network. Flag structural red flags in a transaction request. If the agent is unregistered/unknown for this card member, that alone should score in the 0-29 range regardless of other factors. Return ONLY valid JSON, no other text: {\\\"fraud_risk_score\\\": <integer 0-100, where 100 means no risk detected>, \\\"agent_registered\\\": <true|false>, \\\"reasoning\\\": \\\"<one sentence, under 25 words>\\\"}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"TRANSACTION_REQUEST:\\nagent_id: {{ $('Webhook').item.json.body.agent_id }}\\ncard_member: {{ $('Webhook').item.json.body.card_member }}\\nmerchant: {{ $('Webhook').item.json.body.merchant }}\\namount: {{ $('Webhook').item.json.body.amount }}\\ncategory: {{ $('Webhook').item.json.body.category }}\\n\\nKnown registered agents: agent-047 is registered for J. Alvarez, agent-012 is registered for M. Chen, agent-033 is registered for R. Okafor. Any other agent_id is NOT registered. Evaluate this request for fraud/anomaly signals and return the JSON.\"\n    }\n  ]\n}",
        "options": {}
